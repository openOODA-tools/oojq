// # Lowering Object Construction Into A Collect
//
// Logline: Rewrites a written object into a call the evaluator already has, so nothing in the run has to know what a brace means.
//
// Setup: Pure, no capability needed. Every node here is fixed before a single value is read, which is why the value filters survive as text.
// Beats:
//   1. Split the entries at their first top level colon, in one pass, so the two halves cannot disagree.
//   2. Read each key as a filter as well, so an expression in brackets is answered rather than taken as written.
//   3. Emit one gathered list per entry, value then key, in written order, which is what makes a generator multiply.

import "filter/syntax/scan/parse_span.oo";

// A brace used to be refused by name, and it does not need a rule of its own in
// the run. An object is a product over its entries, a collect already gathers a
// filter's answers into one array, and reading the entries in the order they were
// written puts the one written first in the outer position. So {a: X, b: Y}
// becomes __obj over the body [[X], [X key], [Y], [Y key]], and from there
// everything the run already knows applies. The key travels as a filter too,
// which is why a key written in brackets is answered rather than used as written,
// and why the builtin that builds the object never has to read a filter at all.
type Half = struct {
    head: String,
    tail: String,
    found: Bool
};

// The colon that separates a key from a value is the first one outside every
// bracket and outside a quoted string, which is what makes {(.a): .b} a key of
// (.a) rather than two entries. found is false for the shorthand form, where an
// entry is a key alone and means a value read under that name.
fn split_colon(entry: String) -> Half {
    let n: Int = chars_len(entry);
    let mut depth: Int = 0;
    let mut head: String = "";
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(entry, i);
        if ch == "\"" {
            let e: Int = skip_quote(entry, i);
            head = head + str_slice(entry, i, e);
            i = e;
        } else if ch == "(" || ch == "[" || ch == "{" {
            depth = depth + 1;
            head = head + ch;
            i = i + 1;
        } else if ch == ")" || ch == "]" || ch == "}" {
            depth = depth - 1;
            head = head + ch;
            i = i + 1;
        } else if ch == ":" && depth == 0 {
            return Half { head: trim_ws(head), tail: trim_ws(str_slice(entry, i + 1, n)), found: true };
        } else {
            head = head + ch;
            i = i + 1;
        }
    }
    return Half { head: trim_ws(head), tail: "", found: false };
}

// The index just past the closing quote of the string starting at i, so a key or
// a value holding a colon is never split inside its own quotes.
fn skip_quote(text: String, i: Int) -> Int {
    let n: Int = chars_len(text);
    let mut j: Int = i + 1;
    while j < n {
        if char_at(text, j) == "\\" { j = j + 2; }
        else if char_at(text, j) == "\"" { return j + 1; }
        else { j = j + 1; }
    }
    return n;
}

// A key is read by the run as a filter, so a name written plainly is written
// here as a quoted string and comes back as itself, and a quoted key comes back
// with its escapes already read, which is why {("aAb"): 1} and {"aAb": 1} are
// the same object. An expression in brackets is handed over whole.
//
// A key written any other way is refused by name rather than turned into a name
// that looks like it. jq reads {1: 2} and {.k: 1} as syntax errors rather than
// as the keys "1" and ".k", and answering them would build an object that was
// never written, which is the one thing this project will not do.
fn key_filter(key: String) -> Result[String, String] {
    let n: Int = chars_len(key);
    if n == 0 { return Err("an object entry has nothing before its colon"); }
    if char_at(key, 0) == "(" && char_at(key, n - 1) == ")" {
        if n < 3 { return Err("an object key in brackets holds no expression: " + key); }
        return Ok(str_slice(key, 1, n - 1));
    }
    if char_at(key, 0) == "\"" && char_at(key, n - 1) == "\"" { return Ok(key); }
    if !plain_name(key) {
        return Err("an object key must be a name in quotes, a bare name, or an expression in brackets, not " + key);
    }
    return Ok("\"" + key + "\"");
}

// A name written with no punctuation in it. A leading digit is refused with the
// rest, because a key has to be a name and 1 is not one however it is quoted.
fn plain_name(key: String) -> Bool {
    let n: Int = chars_len(key);
    if digit_char(char_at(key, 0)) { return false; }
    let mut i: Int = 0;
    while i < n {
        if !is_ident_char(char_at(key, i)) { return false; }
        i = i + 1;
    }
    return true;
}

// The body the run reads: two gathered lists per entry, its values and then its
// key, with the entries in the order they were written. An object with no
// entries at all is an empty array, and the product over no entries is the one
// empty object, so {} needs no entry to say so.
//
// The shorthand form is a key on its own, meaning a value read under that name,
// so it becomes a field access. jq allows no bracket on a shorthand key, so
// {("a")} is refused here rather than read as a dynamic field.
pub fn object_body(text: String) -> Result[String, String] {
    let entries: List[String] = split_top_commas(trim_ws(text));
    let mut out: String = "[";
    let mut first: Bool = true;
    let mut i: Int = 0;
    while i < list_len(entries) {
        let h: Half = split_colon(list_get(entries, i));
        let k: Result[String, String] = key_filter(h.head);
        match k {
            Err(e) => { return Err(e); }
            Ok(f) => {
                let mut vals: String = "[." + h.head + "]";
                if h.found { vals = "[" + h.tail + "]"; }
                else if char_at(h.head, 0) == "(" {
                    return Err("a shorthand key must be a name written plainly, not an expression in brackets: " + h.head);
                }
                if !first { out = out + ","; }
                out = out + vals + ",[" + f + "]";
                first = false;
            }
        }
        i = i + 1;
    }
    return Ok(out + "]");
}
