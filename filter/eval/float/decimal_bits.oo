// # Decimal Text To IEEE Bits
//
// Logline: Turns a written decimal number into the 64 bit pattern a double holds, correctly rounded, and nothing else.
// Setup: Pure, no capability needed. No arithmetic is built on this page and no value of the tree is a double yet; it exists to be checked against a table of known doubles before anything is written on top of it.
// Beats:
//   1. Read the written number as a sign, an integer part, and a fraction, with any exponent already moved into the point.
//   2. Take the binary digits one at a time, the integer half from the right and the fraction from the left, so no wide integer is ever needed.
//   3. Round to nearest even on a guard and a sticky bit, and refuse what a double cannot hold.

import "filter/eval/num_read.oo";
import "filter/eval/float/subnormal.oo";

type FracStep = struct {
    fp: String,
    bit: Int
};

type IntHalf = struct {
    digits: String,
    bit: Int
};

fn digit_chr(d: Int) -> String {
    return char_at("0123456789", d);
}

fn bit_chr(b: Int) -> String {
    if b == 1 { return "1"; }
    return "0";
}

fn str_rev(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        out = char_at(s, i) + out;
        i = i + 1;
    }
    return out;
}

// A decimal fraction is doubled one digit at a time from the right, carrying
// leftwards. The carry out of the last digit processed is the whole point: it is
// 1 exactly when the doubled fraction reached 1, which is the definition of a
// binary digit of the fraction. Keeping the fraction as digits rather than as a
// rational is what makes this need no wide integer: 10^40 does not fit, and the
// digit run always does. The digit run left over is the unconsumed tail exactly,
// so asking whether it holds a nonzero digit is the whole of the sticky bit.
//
// The order is not a detail. Doubling 0.25 from the left gives digit 2 turning
// into 4 and then digit 5 turning into 10, a carry out of the *middle* of the
// run, which is not a bit of anything: 0.25 doubles to 0.5 and the answer is 0.
// Carrying the way addition carries means starting at the right, and then the
// carry that falls off the end is the bit.
fn frac_step(fp: String) -> FracStep {
    let n: Int = chars_len(fp);
    let mut carry: Int = 0;
    let mut out: String = "";
    let mut i: Int = n - 1;
    while i >= 0 {
        let d: Int = digit_at(fp, i) * 2 + carry;
        carry = d / 10;
        out = digit_chr(d - carry * 10) + out;
        i = i - 1;
    }
    return FracStep { fp: out, bit: carry };
}

// Halving is the mirror of doubling and is read the other way: long division
// leaves the remainder of each position behind, and the last remainder is the
// low bit, so repeated halving walks a decimal integer out from the bottom.
fn half_step(s: String) -> IntHalf {
    let n: Int = chars_len(s);
    let mut rem: Int = 0;
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let cur: Int = rem * 10 + digit_at(s, i);
        let q: Int = cur / 2;
        rem = cur - q * 2;
        if chars_len(out) > 0 || q != 0 { out = out + digit_chr(q); }
        i = i + 1;
    }
    if chars_len(out) == 0 { return IntHalf { digits: "0", bit: rem }; }
    return IntHalf { digits: out, bit: rem };
}

fn int_bits(ip: String) -> String {
    let mut s: String = ip;
    let mut rev: String = "";
    while s != "0" {
        let h: IntHalf = half_step(s);
        s = h.digits;
        rev = rev + bit_chr(h.bit);
    }
    return str_rev(rev);
}

fn nonzero_left(fp: String) -> Bool {
    let n: Int = chars_len(fp);
    let mut i: Int = 0;
    while i < n {
        if char_at(fp, i) != "0" { return true; }
        i = i + 1;
    }
    return false;
}

// Sixteen digits of hex, read from the word four bits at a time. The word this
// is given always has bit 63 clear: a negative double keeps its magnitude in the
// other 63 bits and takes its sign from the caller, because IEEE negation flips
// that one bit and is not the arithmetic negation of the whole word.
fn hex_chr(nib: Int) -> String {
    return char_at("0123456789abcdef", nib);
}

fn hex16(word: Int) -> String {
    let mut out: String = "";
    let mut k: Int = 15;
    while k >= 0 {
        let nib: Int = (word >> (k * 4)) & 15;
        out = out + hex_chr(nib);
        k = k - 1;
    }
    return out;
}

pub fn decimal_bits(text: String) -> Result[String, String] {
    let n: Num = num_read(text);
    if num_is_zero(n) {
        if n.neg { return Ok("8000000000000000"); }
        return Ok("0000000000000000");
    }
    // The integer part holds the leading 1 outright when it has one. When it has
    // none the value is below 1 and the leading 1 is somewhere in the fraction,
    // so the digits are generated until it is found; its index is the exponent.
    let ib: String = int_bits(n.ip);
    let bi: Int = chars_len(ib);
    let mut fbits: String = "";
    let mut fp: String = n.fp;
    let mut lead: Int = 0;
    if bi == 0 {
        let mut j: Int = 0;
        let mut found: Bool = false;
        while !found && j < 1100 {
            let s: FracStep = frac_step(fp);
            fp = s.fp;
            fbits = fbits + bit_chr(s.bit);
            if s.bit == 1 { found = true; }
            j = j + 1;
        }
        if !found { return Err("decimal_bits: value is below the smallest double"); }
        lead = j - 1;
    }
    // The exponent of the leading one, which is the whole of what decides
    // which of the two shapes the answer takes.
    let e2: Int = bi - 1 - lead;
    // One bit past the 52 stored ones is the guard. Digits before the point
    // count toward the 53 first, so a long integer part needs fewer fraction
    // digits, and one longer than 54 already carries everything including sticky.
    //
    // This run is long enough for a subnormal too, and that is not obvious. For
    // one, bi is zero and lead is -e2-1, so the index the subnormal field ends
    // at is lead + e2 + 1074, which is 1073 whatever the value is: the format
    // fixes where 2^-1074 sits. The run reaches lead+53, and lead is at least
    // 1022 there, so it always covers it. An earlier version of this page grew
    // the run for subnormals on the strength of a formula that is a constant.
    let need: Int = lead + 54 - bi;
    while chars_len(fbits) < need {
        let s: FracStep = frac_step(fp);
        fp = s.fp;
        fbits = fbits + bit_chr(s.bit);
    }
    // The leading 1 sits at index lead of the joined string in both cases: when
    // the integer part had one it is the first bit of it, and when it did not,
    // the fraction digits already carry their own run of leading zeros and the
    // one found above is lead digits in. Padding here as well would count those
    // zeros twice and push the whole significand right, which reads 0.1 as
    // 0x3fb3333333333333 instead of 0x3fb999999999999a.
    let bits: String = ib + fbits;
    // An overflow CLAMPS to the largest double rather than refusing, and this is
    // the second of the two places it can happen. jq has no infinity: 1e308 * 10
    // is 1.7976931348623157e+308, and so is 1e308 / 1e-10 and 1 / 1e-320.
    if e2 > 1023 {
        if n.neg { return Ok("ffefffffffffffff"); }
        return Ok("7fefffffffffffff");
    }
    // The bound is -1075 and not -1022, and not -1074 either. A subnormal's
    // leading one sits between 2^-1074 and 2^-1023, so the old -1022 bound
    // rejected the whole range and 5e-324 + 1e-323 was an error where jq
    // answers 1.5e-323.
    //
    // -1074 is one place too strict in the other direction. A value whose
    // leading one is at 2^-1075 is between half an ulp and one ulp, and it
    // rounds UP to one ulp: 0.2 * 1.5e-323 is 3e-324, which is 0.607 of an ulp,
    // and refusing it answered ERR where the answer is 0000000000000001. Only
    // 2^-1076 and below is a genuine underflow, and that is decided by the
    // guard inside sub_bits rather than here. The 2^-1075 tie lands on this
    // branch too, with mant zero and an even significand, and so still goes to
    // zero exactly as it did when the caller owned it.
    if e2 < 0 - 1075 { return Err("decimal_bits: value is below the smallest double"); }
    let mut word: Int = 0;
    if e2 < 0 - 1022 {
        // A subnormal is M * 2^-1074 with M the stored bits and the leading
        // one among them, so the answer is that integer with no exponent field
        // added. M == 2^52 after rounding is the smallest normal, and it needs
        // no special case: (0 << 52) | 2^52 and (1 << 52) | 0 are both
        // 0x0010000000000000.
        word = sub_bits(bits, nonzero_left(fp), lead + e2 + 1074);
    } else {
        // The 52 stored bits run left to right, so the accumulator is fed in
        // that order too. Walking them from the other end reads bit 1 as the
        // least significant one and turns 3, whose significand is 1 followed by
        // 51 zeros, into 1.5.
        let mut mant: Int = 0;
        let mut g: Int = 1;
        while g <= 52 {
            mant = mant * 2 + digit_at(bits, lead + g);
            g = g + 1;
        }
        let guard: Int = digit_at(bits, lead + 53);
        // Sticky is whatever was dropped, from either side: the fraction tail
        // that was never turned into digits, and the integer digits that sit
        // below the guard when the integer part alone was long enough to reach
        // it.
        let mut sticky: Bool = nonzero_left(fp);
        let mut t: Int = lead + 54;
        while t < chars_len(bits) {
            if digit_at(bits, t) == 1 { sticky = true; }
            t = t + 1;
        }
        if guard == 1 && (sticky || mant % 2 == 1) { mant = mant + 1; }
        let mut ex: Int = e2;
        if mant == 4503599627370496 { mant = 0; ex = ex + 1; }
        // The rounding carried into the next exponent field and off the top of
        // the format, so the value is past the largest double however the digit
        // it was rounded from looks. It clamps, for the same reason as above.
        if ex > 1023 {
            if n.neg { return Ok("ffefffffffffffff"); }
            return Ok("7fefffffffffffff");
        }
        word = (ex + 1023) * 4503599627370496 + mant;
    }
    // A negative double is this word with bit 63 set and nothing else changed.
    // Negating the whole word instead gives the two's complement of the
    // magnitude, which is a different number: -1 came out 0xc010000000000000,
    // an exponent one too big, where IEEE wants 0xbff0000000000000. Only the top
    // nibble moves, and the word never has bit 63 set, so adding 8 to that
    // nibble is the whole of it and the other fifteen digits carry over.
    if n.neg {
        let top: Int = (word >> 60) + 8;
        return Ok(hex_chr(top) + str_slice(hex16(word), 1, 16));
    }
    return Ok(hex16(word));
}
