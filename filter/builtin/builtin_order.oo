// # String Ordering And Key Sorting
//
// Logline: Orders strings so a builtin can emit keys in the order jq emits them.
//
// Setup: Pure, no capability needed. The language has no string comparison, so ordering is defined here by code point.
// Beats:
//   1. Compare two strings by code point, returning a negative, zero, or positive.
//   2. Sort a list of strings with a stable insertion pass.
//   3. Keep one shared string order for object key comparison, which filter/run/eval_sort.oo relies on.

import "parse/anchor.oo";

fn code_of(c: String) -> Int {
    let n: Int = chars_len(c);
    if n != 1 {
        return 0;
    }
    return byte_at(c, 0) & 255;
}

// A non-ASCII code point sorts after every ASCII one, which keeps ordering
// total and deterministic even when the input is not valid UTF-8.
pub fn compare_strings(a: String, b: String) -> Int {
    let na: Int = chars_len(a);
    let nb: Int = chars_len(b);
    let n: Int = na;
    if nb < n {
        let m: Int = nb;
        let mut i: Int = 0;
        while i < m {
            let d: Int = code_of(char_at(a, i)) - code_of(char_at(b, i));
            if d != 0 { return d; }
            i = i + 1;
        }
        return na - nb;
    }
    let mut i: Int = 0;
    while i < n {
        let d: Int = code_of(char_at(a, i)) - code_of(char_at(b, i));
        if d != 0 { return d; }
        i = i + 1;
    }
    return na - nb;
}

pub fn sort_strings(xs: List[String]) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    while i < list_len(xs) {
        let v: String = list_get(xs, i);
        out = insert_sorted(out, v);
        i = i + 1;
    }
    return out;
}

// Insert after every existing entry that does not sort greater, which leaves
// equal keys in their original order. std has no list_insert, so the result is
// rebuilt in one pass.
fn insert_sorted(xs: List[String], v: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut placed: Bool = false;
    let mut i: Int = 0;
    while i < list_len(xs) {
        if !placed && compare_strings(list_get(xs, i), v) > 0 {
            out = list_push(out, v);
            placed = true;
        }
        out = list_push(out, list_get(xs, i));
        i = i + 1;
    }
    if !placed {
        out = list_push(out, v);
    }
    return out;
}

// sort and unique used to live here, ordering by code point over sval. That only
// ever worked for strings: every other kind read back as the empty string, so a
// number array sorted as a run of empties and unique kept one of them. They are
// answered by filter/run/eval_sort.oo now, which orders whole values. This page
// keeps the string order because comparing object keys still needs it.
