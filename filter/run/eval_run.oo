// # Running A Parsed Filter Over A Value Stream
//
// Logline: Walks a parsed filter once per value, and owns every built-in whose argument is itself a filter.
//
// Setup: Pure, no capability needed. Everything here takes an arena and a list of node indices, so a node that mints a value hands the grown arena to whatever runs next.
// Beats:
//   1. Send each node kind to one rule, carrying the arena so minted values stay addressable.
//   2. Parse a bracketed body when the run reaches it, so a filter argument needs no pass.
//   3. Fold the joining operators, the bracketed forms, and the members walk.
import "filter/ast.oo";
import "filter/select_node.oo";
import "filter/syntax/anchor.oo";
import "filter/eval/anchor.oo";
import "filter/run/eval_join.oo";
import "filter/run/eval_sort.oo";
import "filter/run/eval_bykey.oo";
import "filter/run/eval_each.oo";
import "filter/builtin/rewrite/rewrite.oo";
import "render/render_value.oo";

pub fn eval_text(doc: JDoc, input: List[Int], text: String) -> Result[SRes, String] {
    match parse_filter(text) {
        Err(e) => { return Err(e); }
        Ok(p) => { return eval_filter(p.ast, p.node, doc, input); }
    }
}

pub fn eval_filter(ast: AList, node: Int, doc: JDoc, input: List[Int]) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    if n.kind == "ident" { return Ok(SRes { doc: doc, out: input }); }
    if n.kind == "func" { return run_builtin(ast, node, doc, input); }
    if is_suffix(n.kind) { return guarded(ast, node, doc, input, false); }
    if n.kind == "optional" { return guarded(ast, node, doc, input, true); }
    if list_len(input) < 2 { return step_once(ast, node, doc, input); }
    return per_value(ast, node, doc, input, false);
}

// One input value at a time, which is how jq reads every step above a field
// access. Reading the whole stream in one go made `.items[]|.id * 2` nine
// answers instead of three, because the operator paired across values and a
// right hand side that is the same for each answered once per value; the same
// read made `.items[]|.id, .k` answer the whole left stream and then the right.
// skip is what a question mark asks for: a value that cannot take the step is
// left out and the walk goes on, so (.a,.b)|.c? is 2 rather than nothing.
fn per_value(ast: AList, node: Int, doc: JDoc, input: List[Int], skip: Bool) -> Result[SRes, String] {
    let mut live: JDoc = doc;
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(input) {
        match eval_filter(ast, node, live, one(list_get(input, i))) {
            Err(e) => { if !skip { return Err(e); } }
            Ok(z) => { live = z.doc; out = concat_indices(out, z.out); }
        }
        i = i + 1;
    }
    return Ok(SRes { doc: live, out: out });
}

fn step_once(ast: AList, node: Int, doc: JDoc, input: List[Int]) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    if n.kind == "paren" { return eval_text(doc, input, n.sval); }
    if n.kind == "collect" { return gather(doc, input, n.sval); }
    if n.kind == "ifthen" { return eval_if(doc, input, n); }
    if n.kind == "bin" { return eval_bin(ast, node, doc, input); }
    if n.kind == "pipe" || n.kind == "comma" || n.kind == "alt" || n.kind == "and" || n.kind == "or" { return fold(ast, node, doc, input, n.kind); }
    // A literal, and .., are the value in hand, so the leaf page reads them.
    return eval_each(ast, node, doc, input);
}

fn fold(ast: AList, node: Int, doc: JDoc, input: List[Int], kind: String) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    match eval_filter(ast, n.a, doc, input) {
        Err(e) => { return Err(e); }
        Ok(r) => {
            let got: List[Int] = r.out;
            let feed: List[Int] = side_input(kind, r.doc, got, input);
            match eval_filter(ast, n.b, r.doc, feed) {
                Err(e) => { return Err(e); }
                Ok(z) => { return combine_sides(z.doc, kind, got, z.out); }
            }
        }
    }
}

// A unary minus rides the binary path with no right hand side. Both sides are
// read over this one value, so a right hand side that ignores its input answers
// once however many values reached here, and the pairs stay the pairs of this
// value alone. The pairs are walked right first.
fn eval_bin(ast: AList, node: Int, doc: JDoc, input: List[Int]) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    match eval_filter(ast, n.a, doc, input) {
        Err(e) => { return Err(e); }
        Ok(r) => {
            let mut out: List[Int] = list_new();
            if n.b < 0 { return neg_over(r.doc, r.out); }
            match eval_filter(ast, n.b, r.doc, input) {
                Err(e) => { return Err(e); }
                Ok(z) => {
                    let mut live: JDoc = z.doc;
                    let rights: List[Int] = z.out;
                    let lefts: List[Int] = r.out;
                    let mut j: Int = 0;
                    while j < list_len(rights) {
                        let seed: SRes = SRes { doc: live, out: list_new() };
                        match append_pairs(seed, n.name, list_get(rights, j), lefts) {
                            Err(e) => { return Err(e); }
                            Ok(v) => { live = v.doc; out = concat_indices(out, v.out); }
                        }
                        j = j + 1;
                    }
                    return Ok(SRes { doc: live, out: out });
                }
            }
        }
    }
}

// A collect is a per value step: the body is read once for each value that
// reached it and the answers become one array, which is per_member's map mode
// walking the value itself instead of its members.
fn gather(doc: JDoc, input: List[Int], body: String) -> Result[SRes, String] {
    let inner: String = trim_ws(body);
    if chars_len(inner) == 0 { return Ok(empty_arrays(doc, list_len(input))); }
    return per_member(doc, input, inner, "collect");
}

// The branch is read over the value the condition was asked of, not over the
// verdict it answered, and once for each of the condition's answers, so
// if .a>1 then .a else 0 end reads .a of the value and not of the true.
fn eval_if(doc: JDoc, input: List[Int], n: ANode) -> Result[SRes, String] {
    match eval_text(doc, input, n.sval) {
        Err(e) => { return Err(e); }
        Ok(r) => {
            let mut live: JDoc = r.doc;
            let mut out: List[Int] = list_new();
            let mut i: Int = 0;
            while i < list_len(r.out) {
                let mut branch: String = n.t2;
                if truthy(jval_at(live, list_get(r.out, i))) { branch = n.t1; }
                match eval_text(live, input, branch) {
                    Err(e) => { return Err(e); }
                    Ok(z) => { live = z.doc; out = concat_indices(out, z.out); }
                }
                i = i + 1;
            }
            return Ok(SRes { doc: live, out: out });
        }
    }
}

// A question mark turns a refusal into no value here all, so .a.b? is safe,
// asked of one value at a time so that only the value which fails is left out.
fn guarded(ast: AList, node: Int, doc: JDoc, input: List[Int], swallow: Bool) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    if swallow { return per_value(ast, n.a, doc, input, true); }
    match eval_filter(ast, n.a, doc, input) {
        Err(e) => { return Err(e); }
        Ok(r) => { return apply_step(r.doc, r.out, n); }
    }
}

fn per_member(doc: JDoc, input: List[Int], body: String, mode: String) -> Result[SRes, String] {
    let mut live: JDoc = doc;
    let mut out: List[Int] = list_new();
    let mut g: GSort = gs_new();
    let mut i: Int = 0;
    while i < list_len(input) {
        let node: Int = list_get(input, i);
        let v: JVal = jval_at(live, node);
        if mode != "select" && mode != "collect" && v.kind != "array" && v.kind != "object" {
            return Err("Cannot iterate over " + kind_word(v.kind) + " (" + shown_value(doc, node) + ")");
        }
        let mut members: List[Int] = v.kids;
        if mode == "select" || mode == "collect" { members = one(node); }
        let mut acc: Bool = mode == "all";
        let mut kept: List[Int] = list_new();
        let mut j: Int = 0;
        while j < list_len(members) {
            let e: Int = list_get(members, j);
            match eval_text(live, one(e), body) {
                Err(why) => { return Err(why); }
                Ok(z) => {
                    live = z.doc;
                    let hit: Bool = keeps(live, z.out);
                    if mode == "map" || mode == "collect" { kept = concat_indices(kept, z.out); }
                    if mode == "select" && hit { kept = list_push(kept, e); }
                    if mode == "any" && hit { acc = true; }
                    if mode == "all" && !hit { acc = false; }
                    if is_by_key(mode) { g = gs_push(g, e, head_or(e, z)); }
                }
            }
            j = j + 1;
        }
        // map is [.[]], and a collect is [.] over the value itself, so both
        // gather their results into one array; select is the value in hand.
        // This stayed inline after being moved out to filter/run/member: handing
        // the kept list to a page that hands it back produced an empty answer for
        // every mode that uses it, and the compiler reported the build clean.
        if mode == "map" || mode == "collect" {
            let made: SRes = array_result(live, kept);
            live = made.doc;
            let gathered: List[Int] = made.out;
            out = concat_indices(out, gathered);
        }
        if mode == "select" { out = concat_indices(out, kept); }
        if mode == "any" || mode == "all" {
            let verdict: SRes = bool_result(live, acc);
            live = verdict.doc;
            out = concat_indices(out, verdict.out);
        }
        // The five order-by-a-key builtins all arrive with the same pairs here.
        if is_by_key(mode) {
            let made: SRes = answer_by_key(live, g, mode);
            live = made.doc;
            let got: List[Int] = made.out;
            out = concat_indices(out, got);
            g = gs_new();
        }
        i = i + 1;
    }
    return Ok(SRes { doc: live, out: out });
}

fn run_builtin(ast: AList, node: Int, doc: JDoc, input: List[Int]) -> Result[SRes, String] {
    let n: ANode = ast_at(ast, node);
    let body: String = trim_ws(n.sval);
    if is_member_builtin(n.name) {
        if chars_len(body) == 0 && !bare_member(n.name) { return Err("\"" + n.name + "\" needs a filter argument"); }
        return per_member(doc, input, member_body(body, n.name), n.name);
    }
    // What needs no filter argument is answered off the hub, so what is left is a
    // call whose argument really is a filter. Refused before the body is read:
    // the body of sub is not a filter.
    if n.name == "sub" || n.name == "gsub" { return Err(regex_gap(n.name)); }
    if is_routed(n.name) || n.name == "range" || chars_len(body) == 0 {
        return route_builtin(doc, input, n.name, body);
    }
    // The argument lands in a grown arena and each field is read only once.
    if list_len(input) == 0 { return Ok(SRes { doc: doc, out: list_new() }); }
    // A call whose argument is a filter reads that filter over one value, so a
    // stream of more than one is split first. The two branches above must not do
    // this: a member builtin walks the stream itself, and a routed one reads its
    // argument as text. Object construction is what exposed the missing split.
    if list_len(input) > 1 { return per_value(ast, node, doc, input, false); }
    match eval_text(doc, one(list_get(input, 0)), body) {
        Err(e) => { return Err(e); }
        Ok(r) => {
            if list_len(r.out) == 0 { return run_leaf(doc, input, n.name, 0 - 1); }
            let here: Int = list_get(r.out, list_len(r.out) - 1);
            if n.name == "getpath" { return builtin_getpath(r.doc, input, here); }
            if is_written(n.name) { return written_builtin(r.doc, input, n.name, here); }
            return run_leaf(r.doc, input, n.name, here);
        }
    }
}
