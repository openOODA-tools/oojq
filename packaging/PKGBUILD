# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oojq-bin
_pkgname=oojq
pkgver=0.1.1
pkgrel=1
pkgdesc="Capability-bounded jq replacement with stdio MCP"
arch=('x86_64')
url="https://github.com/openOODA-tools/oojq"
license=('Apache-2.0')
depends=('glibc')
provides=('oojq')
conflicts=('oojq')
source=("${_pkgname}-${pkgver}::https://github.com/openOODA-tools/oojq/releases/download/v${pkgver}/oojq-linux-x86_64"
        "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums=('SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/${_pkgname}-${pkgver}" "${pkgdir}/usr/bin/oojq"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oojq-uninstall"
}
