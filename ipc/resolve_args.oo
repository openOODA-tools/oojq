// # Resolve Flags, Filter, And Path From Argv
//
// Logline: Decides which arguments are flags, which are filter text, and which name an input file.
//
// Setup: Reads only, holding FsReadCap. The filter rule matches jq: every
// argument before the first one that names an existing file is filter text.
// Beats:
//   1. Let `oojq .a, .b f.json` work unquoted, as jq allows.
//   2. Collect -c, --compact-output, -r, and --raw-output before the filter.
//   3. Refuse a second input file rather than silently ignoring one.

import "filter/anchor.oo";
import "filter/syntax/scan/parse_span.oo";

type Query = struct {
    filter: String,
    path: String,
    compact: Bool,
    raw: Bool,
    exit_status: Bool,
    color: Bool
};

// jq lets short flags be run together, so -ce is two flags and not a filter
// that happens to start with a dash.
fn is_short_run(a: String) -> Bool {
    if chars_len(a) < 2 { return false; }
    if char_at(a, 0) != "-" { return false; }
    let n: Int = chars_len(a);
    let mut i: Int = 1;
    while i < n {
        let ch: String = char_at(a, i);
        if ch != "c" && ch != "e" && ch != "r" && ch != "C" && ch != "M" { return false; }
        i = i + 1;
    }
    return true;
}

// Only a regular file names the input. "." is a real path, so without the
// directory test `oojq -c . doc.json` would claim "." as the document and then
// reject doc.json as a second one.
//
// The two probes are the sealed std builtins called directly rather than
// through std/fs/os/fs.oo, because the installed oodac lexer rejects the arrow
// characters in that page's comments and the file will not build at all.
fn is_input_file(fs: &FsReadCap, a: String) -> Bool {
    if !oo_path_exists(fs, a) {
        return false;
    }
    return !oo_fs_is_dir(fs, a);
}

pub fn resolve_args(fs: &FsReadCap, args: List[String]) -> Result[Query, String] {
    let mut filt: String = "";
    let mut path: String = "";
    let mut compact: Bool = false;
    let mut raw: Bool = false;
    let mut exit_status: Bool = false;
    let mut color: Bool = false;
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if chars_len(path) > 0 {
            return Err("only one input file is supported; \"" + a + "\" is a second");
        }
        if a == "-c" || a == "--compact-output" {
            compact = true;
        } else if a == "-e" || a == "--exit-status" {
            exit_status = true;
        } else if a == "-r" || a == "--raw-output" {
            raw = true;
        } else if a == "-C" || a == "--color-output" || a == "--color" {
            color = true;
        } else if a == "-M" || a == "--monochrome-output" || a == "--no-color" {
            color = false;
        } else if is_short_run(a) {
            let n2: Int = chars_len(a);
            let mut k: Int = 1;
            while k < n2 {
                let ch: String = char_at(a, k);
                if ch == "c" { compact = true; }
                if ch == "e" { exit_status = true; }
                if ch == "r" { raw = true; }
                if ch == "C" { color = true; }
                if ch == "M" { color = false; }
                k = k + 1;
            }
        } else if i > 0 && is_input_file(fs, a) {
            path = a;
        } else {
            filt = filt + " " + a;
        }
        i = i + 1;
    }
    let trimmed: String = trim_ws(filt);
    if chars_len(trimmed) == 0 {
        return Err("no filter given");
    }
    return Ok(Query { filter: trimmed, path: path, compact: compact, raw: raw, exit_status: exit_status, color: color });
}
